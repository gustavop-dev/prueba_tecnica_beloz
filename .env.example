# Local development only. These values are placeholders: never reuse them outside your machine.
# `make up` copies this file to `.env` when `.env` does not exist. `.env` is git-ignored.

DJANGO_SECRET_KEY=local-dev-only-insecure-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Static API tokens: comma-separated role:principal_id:token (roles: customer, operator, payment_provider).
# Two customers to try ownership checks.
AUTH_TOKENS=customer:6f1c2a4e-1b7d-4c39-9a52-3d8e0f7a1c01:local-dev-customer-a-token,customer:6f1c2a4e-1b7d-4c39-9a52-3d8e0f7a1c02:local-dev-customer-b-token

# Provider webhook: shared HMAC-SHA256 secret (at least 32 characters) and the provider's principal id.
WEBHOOK_SIGNING_SECRET=local-dev-only-webhook-signing-secret-000
PAYMENT_PROVIDER_ID=6f1c2a4e-1b7d-4c39-9a52-3d8e0f7a1c0f

POSTGRES_DB=acme
POSTGRES_USER=acme
POSTGRES_PASSWORD=local-dev-only-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Longest wait for a row lock before a money operation answers LOCK_TIMEOUT (CON-9).
DB_LOCK_TIMEOUT_MS=5000

# Host port for the API.
APP_PORT=8000
